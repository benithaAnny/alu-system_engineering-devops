#!/usr/bin/env bash
# install load balancer

echo -e "Updating and doing some minor checks...\n"

function install() {
	command -v "$1" &> /dev/null

	#shellcheck disable=SC2181
	if [ $? -ne 0 ]; then
		echo -e "\tInstalling: $1\n"
		sudo apt-get update -y -qq && \
			sudo apt-get install -y "$1" -qq
		echo -e "\n"
	else
		echo -e "\t${1} is already installed.\n"
	fi
}

install haproxy #install haproxy

echo -e "\nSetting up some minor stuff.\n"

# backup default server config file
sudo cp /etc/haproxy/haproxy.cfg haproxy_default.backup

# write haproxy config
#shellcheck disable=SC2154
sudo tee /etc/haproxy/haproxy.cfg > /dev/null <<EOF
global
	daemon
	maxconn 256

defaults
	mode http
	timeout client 15s
	timeout connect 10s
	timeout server 15s
	timeout http-request 10s

frontend 7085-frontend
	bind *:80
	default_backend 7085-backend

backend 7085-backend
	balance roundrobin
	server 7085-web-01 54.85.44.66:80 check
	server 7085-web-02 44.201.231.167:80 check
EOF

# validate config before (re)starting, so we never restart into a broken state
if sudo haproxy -c -f /etc/haproxy/haproxy.cfg; then
	# enable haproxy to be started by init script
	echo "ENABLED=1" | sudo tee /etc/default/haproxy > /dev/null
	sudo systemctl enable haproxy

	if [ "$(pgrep -c haproxy)" -le 0 ]; then
		sudo service haproxy start
	else
		sudo service haproxy restart
	fi
else
	echo "haproxy config test failed - not restarting, check /etc/haproxy/haproxy.cfg"
	exit 1
fi
