
 #!/usr/bin/env bash
# This bash script transfers a file to the home directory of a remote server,
# and ensures Apache serves it via a symlink at the document root.

file_path="$1"
server_ip="$2"
username="$3"
ssh_key="$4"

if [ "$#" -ne 4 ]; then
    echo "Usage: 0-transfer_file PATH_TO_FILE IP USERNAME PATH_TO_SSH_KEY"
    exit 1
fi

scp -i "$ssh_key" -o StrictHostKeyChecking=no "$file_path" "$username@$server_ip:~/"

if [ $? -eq 0 ]; then
    echo "File transferred successfully."
else
    echo "Failed to transfer file."
    exit 1
fi

# Ensure Apache's document root symlinks to the transferred file
ssh -i "$ssh_key" -o StrictHostKeyChecking=no "$username@$server_ip" \
    "sudo rm -f /var/www/html/index.html && \
     sudo ln -s /home/$username/$(basename "$file_path") /var/www/html/index.html && \
     sudo service apache2 reload"
