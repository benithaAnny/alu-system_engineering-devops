#!/usr/bin/env bash
# Installing Nginx on Ubuntu
# Nginx listens on port 80
# The GET request to / should return a page containing "Holberton School"

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx

# Make sure the web root exists and has our content
mkdir -p /var/www/html
echo "Holberton School" > /var/www/html/index.html

# Force nginx's default site to actually serve from /var/www/html,
# regardless of what the distro's default root path was
sed -i 's|root .*;|root /var/www/html;|' /etc/nginx/sites-available/default

# Start/restart nginx without systemctl
service nginx restart
