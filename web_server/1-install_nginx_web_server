#!/usr/bin/env bash
# Installing Nginx on Ubuntu
# Nginx is listening on port 80
# The GET request should return a page containing "Holberton School"

# Update package lists, then upgrade installed packages
sudo apt-get update && sudo apt-get upgrade -y

# Install nginx, -y auto-confirms the install prompt
sudo apt-get install nginx -y

# /var/www/html usually already exists after installing nginx,
# but -p makes mkdir safe to run anyway (won't error if it exists)
sudo mkdir -p /var/www/html

# Create the file (optional since tee below will create it anyway)
sudo touch /var/www/html/index.html

# echo runs as your normal user; piping into `sudo tee` lets the
# write happen with root privileges instead
echo "Holberton School" | sudo tee /var/www/html/index.html

# Restart nginx so it's definitely running and serving the new file
sudo service nginx restart


