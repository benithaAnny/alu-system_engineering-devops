#!/usr/bin/env bash
# Installing Nginx on Ubuntu
# Nginx listens on port 80
# The GET request to / should return a page containing "Holberton School"

sudo apt-get update -y
sudo apt-get install -y nginx

# Make sure the web root exists (nginx creates it too, -p avoids errors if it already does)
sudo mkdir -p /var/www/html

# Write the required content (must use tee with sudo, NOT sudo echo > file)
echo "Holberton School" | sudo tee /var/www/html/index.html

# Start/restart nginx without systemctl
sudo service nginx restart

